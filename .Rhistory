library(ggplot2)
penguins <-read.csv("C:/Users/user/OneDrive/Desktop/R/R_Course/Data/penguins.csv")
ggplot(data=penguins)
ggplot(data=penguins, aes(x=flipper_length_mm, y=body_mass_g))
#data plotted
ggplot(data=penguins, aes(x=flipper_length_mm, y=body_mass_g)) + geom_point()
ggplot() + geom_point(data=penguins, aes(x=flipper_length_mm, y=body_mass_g))
ggplot(data=penguins, aes(x=flipper_length_mm, y=body_mass_g, colour =species)) + geom_point()
ggplot(data=penguins, aes(x=flipper_length_mm, y=body_mass_g, colour =island)) + geom_point()
ggplot(data=penguins, aes(x=flipper_length_mm, y=body_mass_g)) + geom_point(colour="blue")
#shape by species
ggplot(data=penguins, aes(x=flipper_length_mm, y=body_mass_g, shape=species)) + geom_point()
#shape by island
ggplot(data=penguins, aes(x=flipper_length_mm, y=body_mass_g, shape=island)) + geom_point()
#shape and colour by species
ggplot(data=penguins, aes(x=flipper_length_mm, y=body_mass_g, shape=species, colour=species)) + geom_point()
#shape and colour by island
ggplot(data=penguins, aes(x=flipper_length_mm, y=body_mass_g, shape=island, colour=island)) + geom_point()
#shape and colour by species
ggplot(data=penguins, aes(x=flipper_length_mm, y=body_mass_g, shape=species, colour=island)) + geom_point()
ggplot(data=penguins, aes(x=species))+ geom_bar()
ggplot(data=penguins, aes(x=species, y=bill_length_mm)) + geom_boxplot()
ggplot(data=penguins, aes(x=year, y=flipper_length_mm, colour=species)) + geom_line()
ggplot(data=penguins, aes(x=body_mass_g, fill=species)) + geom_density()
##fixing the hidden overlap
ggplot(data=penguins, aes(x=body_mass_g, fill=species)) + geom_density(alpha=0.1)
ggplot(data=penguins, aes(x=body_mass_g, colour=species)) + geom_density()
ggplot(data=penguins, aes(x=body_mass_g)) +
geom_histogram(binwidth = 100,fill="blue", colour="black")
ggplot(data=penguins, aes(x=body_mass_g)) +
geom_histogram(binwidth = 100,fill="blue", colour="red")
ggplot(data=penguins, aes(x=body_mass_g)) +
geom_histogram(binwidth = 100,fill="green", colour="black")
ggplot(data=penguins, aes(x=species, y=bill_depth_mm, fill=species)) +
geom_violin()
ggplot(data=penguins, aes(x=species, y=bill_depth_mm)) +
geom_violin(fill="blue")
penguins_summary<-penguins %>%
group_by(species, sex, year) %>%
summarise(mean_body_mass_g=mean(body_mass_g,na.rm = TRUE)) %>%
select(species, sex, mean_body_mass_g, year) %>%
filter(!is.na(sex))
head(penguins_summary)
ggplot(data=penguins_summary, aes(x=year, y=mean_body_mass_g, colour=species)) +
geom_line()
ggplot(data=penguins_summary, aes(x=year, y=mean_body_mass_g, colour=species, linetype=sex)) +   geom_line()
ggplot(data=penguins_summary, aes(x=year, y=mean_body_mass_g, colour=species, linetype=sex)) +   geom_line() + geom_point()
ggplot(data=penguins, aes(x=bill_length_mm, y=flipper_length_mm, colour=species)) +   geom_point() +
facet_wrap(~species)
ggplot(data=penguins, aes(x=bill_length_mm, y=flipper_length_mm, colour=species)) +   geom_point() +
facet_grid(year ~species)
ggplot(penguins, aes(x=bill_length_mm, y=flipper_length_mm, colour=species)) +
geom_point() +
labs(title = "Bill Length vs. Flipper Length",
subtitle = "Relationship between bill length and flipper length in penguins",
x="Bill Length (mm)",
y="Flipper Length (mm)",
colour="Species")
ggplot(data=penguins, aes(x=bill_length_mm, y=flipper_length_mm, colour=species)) +   geom_point() +
theme_bw()
ggplot(data=penguins, aes(x=bill_length_mm, y=flipper_length_mm, colour=species)) +   geom_point() +
theme_minimal()
ggplot(data=penguins, aes(x=bill_length_mm, y=flipper_length_mm, colour=species)) +   geom_point() +
theme_dark()
#install.packages("ggthemes")
library(ggthemes)
ggplot(data=penguins, aes(x=flipper_length_mm, y=body_mass_g, colour=species)) +   geom_point() +
theme_economist()
ggplot(data=penguins, aes(x=flipper_length_mm, y=body_mass_g, colour=species)) +   geom_point() +
theme_stata()
#install.packages("patchwork")
library(patchwork)
#Create individual ggplot2 plots
plot1<-ggplot(data=penguins, aes(x=bill_length_mm, y=bill_depth_mm, colour=species)) +   geom_point() +
labs(title = "Bill Length vs. Bill Depth")
plot2<-ggplot(data=penguins, aes(x=flipper_length_mm, y=body_mass_g, colour=species)) +   geom_point() +
labs(title = "Flipper Length vs. Body Mass")
plot3<-ggplot(data=penguins, aes(x=island, fill=species)) +
geom_bar() +
labs(title = "Species Distribution by Island")
plot4<-ggplot(data=penguins, aes(x=species, y=bill_length_mm)) +
geom_boxplot() +
labs(title = "Bill Lenth Distribution by Species")
#Combine and arrange the plots using Patchwork
combined_plots<-(plot1|plot2)/(plot3|plot4)
#Display the combined plot
combined_plots
